<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GroceryApp.ViewModels"
             x:Class="GroceryApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Label Grid.Row="0"
               Text="Settings"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="Black"
               Padding="20,16,20,12" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,28" Spacing="14">

                <!-- User Information -->
                <Border Style="{StaticResource CreamSectionBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="User Information"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="Black" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <!-- Avatar circle -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Primary}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 24"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    VerticalOptions="Center">
                                <Label Text="👤"
                                       FontSize="24"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding FullName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="Black" />
                                <Label FontSize="13" TextColor="#666">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="@" />
                                            <Span Text="{Binding Username}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border BackgroundColor="#FFE5C0"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="8,3"
                                        HorizontalOptions="Start"
                                        Margin="0,4,0,0">
                                    <Label Text="{Binding Role}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Sync Controls -->
                <Border Style="{StaticResource CreamSectionBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Sync Controls"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="Black" />

                        <Button Text="↻  Refresh Data"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="22"
                                HeightRequest="44"
                                Command="{Binding ResetSyncCommand}" />

                        <BoxView HeightRequest="1" Color="#E5D9C0" />

                        <!-- App Services row -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="☁️" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="App Services"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="Black" />
                                <Label Text="{Binding IsAppServicesEnabled, Converter={StaticResource SyncStatusSubtextConverter}}"
                                       FontSize="11"
                                       TextColor="#666" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding IsAppServicesEnabled, Mode=TwoWay}"
                                    OnColor="{StaticResource Primary}" />
                        </Grid>

                        <!-- Sync status pill -->
                        <Border BackgroundColor="White"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="●"
                                       FontSize="14"
                                       TextColor="#16A34A"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding SyncStatus}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="Black"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       FontSize="11"
                                       TextColor="#666"
                                       VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Last: " />
                                            <Span Text="{Binding LastSyncTime}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </Border>

                        <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Primary}" />

                        <Label FontSize="11" TextColor="#888" LineBreakMode="MiddleTruncation">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Endpoint: " FontAttributes="Bold" />
                                    <Span Text="{Binding SyncUrl}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="11" TextColor="#888">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Store: " FontAttributes="Bold" />
                                    <Span Text="{Binding StoreDisplayName}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- App Information -->
                <Border Style="{StaticResource CreamSectionBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="App Information"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="Black" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Version" FontSize="14" TextColor="Black" />
                            <Label Grid.Column="1" Text="1.0.0" FontSize="14" TextColor="Black" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Database" FontSize="14" TextColor="Black" />
                            <Label Grid.Column="1" Text="Couchbase Lite 4.0.3" FontSize="14" TextColor="Black" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Framework" FontSize="14" TextColor="Black" />
                            <Label Grid.Column="1" Text=".NET MAUI 10" FontSize="14" TextColor="Black" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Sign Out -->
                <Button Text="Sign Out"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding LogoutCommand}"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="iOS" Value="0,40,0,0" />
            <On Platform="MacCatalyst" Value="0,20,0,0" />
            <On Platform="Android" Value="0,20,0,0" />
            <On Platform="WinUI" Value="0,16,0,0" />
        </OnPlatform>
    </ContentPage.Padding>
</ContentPage>
