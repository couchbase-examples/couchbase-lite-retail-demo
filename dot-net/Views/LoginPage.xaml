<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GroceryApp.ViewModels"
             x:Class="GroceryApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource Light}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="28,40,28,20" Spacing="24">

                <!-- Logo + Title -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,30,0,10">
                    <Label Text="🛒"
                           FontSize="78"
                           HorizontalOptions="Center" />
                    <Label Text="Grocery Inventory"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center" />
                    <Label Text="Management System"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Username -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Username" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputBorder}" HeightRequest="56">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="👤"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#999" />
                            <Entry Grid.Column="1"
                                   Placeholder="Enter username"
                                   Keyboard="Email"
                                   Text="{Binding Username}"
                                   ReturnType="Next"
                                   TextColor="Black" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputBorder}" HeightRequest="56">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="🔒"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextColor="#999" />
                            <Entry Grid.Column="1"
                                   Placeholder="Enter password"
                                   IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                                   Text="{Binding Password}"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding LoginCommand}"
                                   TextColor="Black" />
                            <Label Grid.Column="2"
                                   Text="{Binding IsPasswordVisible, Converter={StaticResource EyeIconConverter}}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#999"
                                   VerticalOptions="Center"
                                   Padding="6,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleShowPasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Sign In Button -->
                <Button Text="→ Sign In"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding CanSubmit}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Danger}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <!-- View Demo Credentials link -->
                <Label HorizontalTextAlignment="Center"
                       FontSize="14"
                       TextColor="Black"
                       FontAttributes="Bold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="ⓘ  " TextColor="#999" />
                            <Span Text="View Demo Credentials" TextColor="Black" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCredentialsCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Couchbase footer -->
        <VerticalStackLayout Grid.Row="1" Spacing="6" Padding="0,12,0,24" HorizontalOptions="Center">
            <Image Source="couchbase_logo.png"
                   HeightRequest="44"
                   WidthRequest="44"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />
            <Label Text="Powered by Couchbase"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
