<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GroceryApp.ViewModels"
             xmlns:models="clr-namespace:GroceryApp.Models"
             x:Class="GroceryApp.Views.DemoCredentialsPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Tap-to-dismiss overlay -->
        <BoxView Grid.Row="0" Color="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Bottom sheet -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Light}"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="20,16,20,28">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="14">

                <!-- Drag indicator -->
                <BoxView WidthRequest="40"
                         HeightRequest="4"
                         Color="#999"
                         CornerRadius="2"
                         HorizontalOptions="Center"
                         Margin="0,0,0,4" />

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Demo Credentials"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="Black" />
                    <Label Grid.Column="1"
                           Text="Done"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Info}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDismissTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Label Text="Tap any credential to auto-login:"
                       FontSize="13"
                       TextColor="#666" />

                <CollectionView ItemsSource="{Binding DemoUsers}"
                                SelectionMode="None"
                                HeightRequest="320">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DemoUser">
                            <Border Margin="0,4"
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCredentialTapped" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Username}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="Black" />
                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="#FFE5C0"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10,3"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Role}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>

                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding FullName}"
                                           FontSize="13"
                                           TextColor="#666" />

                                    <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                                        <Label FontSize="12" TextColor="Black">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Endpoint: " TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                                    <Span Text="{Binding Endpoint}" TextColor="{StaticResource Primary}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontSize="12" TextColor="#444">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Password: " FontAttributes="Bold" />
                                                    <Span Text="{Binding Password}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="• Tap any credential above to auto-login"
                               FontSize="11"
                               TextColor="#666" />
                        <Label Text="• Each user connects to different endpoint"
                               FontSize="11"
                               TextColor="#666" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
