<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GroceryApp.ViewModels"
             xmlns:models="clr-namespace:GroceryApp.Models"
             x:Class="GroceryApp.Views.InventoryPage"
             x:DataType="vm:InventoryViewModel"
             BackgroundColor="#F2F2F4"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Welcome + Role badge row -->
        <Grid Grid.Row="0" Padding="20,16,20,0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="Welcome!"
                   FontSize="15"
                   TextColor="#999"
                   VerticalOptions="Center" />
            <Border Grid.Column="1"
                    BackgroundColor="#E5EEFF"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,6">
                <Label Text="Store Manager"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#1D4ED8" />
            </Border>
        </Grid>

        <!-- Title -->
        <Label Grid.Row="1"
               Text="Grocery Inventory"
               FontSize="34"
               FontAttributes="Bold"
               TextColor="Black"
               Padding="20,6,20,0" />

        <!-- Search -->
        <Border Grid.Row="2"
                Margin="20,16,20,12"
                Padding="16,6"
                Stroke="#E5E5E8"
                StrokeThickness="1"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="🔍"
                       VerticalOptions="Center"
                       FontSize="16"
                       TextColor="#999" />
                <Entry Grid.Column="1"
                       Placeholder="Search"
                       Text="{Binding SearchText}"
                       ClearButtonVisibility="WhileEditing"
                       FontSize="16"
                       PlaceholderColor="#999"
                       TextColor="Black"
                       BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <!-- 2-column inventory grid -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="12"
                                     VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,60" Spacing="10" VerticalOptions="Start" HorizontalOptions="Center">
                        <Label Text="📦"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="No inventory yet"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Pull down to refresh once App Services has synced data."
                               FontSize="13"
                               TextColor="#666"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GroceryItem">
                        <Border Margin="0"
                                Padding="0"
                                BackgroundColor="White"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.06" Radius="12" Offset="0,4" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="0" Padding="14,14,14,14">
                                <!-- Product image -->
                                <Image Source="{Binding ImageUrl}"
                                       Aspect="AspectFit"
                                       HeightRequest="150"
                                       Margin="0,4,0,10" />

                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="Black"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Price, StringFormat='Price: ${0:F2}'}"
                                       FontSize="14"
                                       TextColor="#999"
                                       Margin="0,4,0,0" />

                                <Label Text="Inventory Count"
                                       FontSize="14"
                                       TextColor="#555"
                                       Margin="0,14,0,0"
                                       HorizontalOptions="Center" />

                                <Label Text="{Binding Quantity}"
                                       FontSize="64"
                                       FontAttributes="Bold"
                                       CharacterSpacing="-2"
                                       TextColor="{Binding Quantity, Converter={StaticResource QuantityToColorConverter}}"
                                       HorizontalOptions="Center"
                                       Margin="0,-2,0,4">
                                    <Label.FontFamily>
                                        <OnPlatform x:TypeArguments="x:String">
                                            <On Platform="iOS" Value="HelveticaNeue-Bold" />
                                            <On Platform="MacCatalyst" Value="HelveticaNeue-Bold" />
                                            <On Platform="Android" Value="sans-serif-medium" />
                                        </OnPlatform>
                                    </Label.FontFamily>
                                </Label>

                                <HorizontalStackLayout Spacing="18" HorizontalOptions="Center" Margin="0,4,0,12">
                                    <Border WidthRequest="44"
                                            HeightRequest="44"
                                            Stroke="#CCC"
                                            StrokeThickness="2"
                                            StrokeShape="RoundRectangle 22"
                                            BackgroundColor="Transparent">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=DecrementCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="−"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               TextColor="#999"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <Border WidthRequest="44"
                                            HeightRequest="44"
                                            Stroke="#CCC"
                                            StrokeThickness="2"
                                            StrokeShape="RoundRectangle 22"
                                            BackgroundColor="Transparent">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=IncrementCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="+"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               TextColor="#999"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Button Text="Re-order now"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        CornerRadius="10"
                                        HeightRequest="46"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=OpenCreateOrderCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="iOS" Value="0,40,0,0" />
            <On Platform="MacCatalyst" Value="0,20,0,0" />
            <On Platform="Android" Value="0,20,0,0" />
            <On Platform="WinUI" Value="0,16,0,0" />
        </OnPlatform>
    </ContentPage.Padding>
</ContentPage>
