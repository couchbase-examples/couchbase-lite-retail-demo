<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.couchbase.grocery.ui.DemoCredentialsController"
      styleClass="sheet-root">

    <padding><Insets top="14" right="16" bottom="16" left="16"/></padding>

    <!-- Title bar -->
    <HBox alignment="CENTER" styleClass="sheet-titlebar">
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Demo Credentials" styleClass="sheet-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="doneButton" text="Done" styleClass="sheet-done"/>
    </HBox>

    <Label text="DEMO USER ACCOUNTS — TAP TO LOGIN" styleClass="section-header">
        <VBox.margin><Insets top="20" bottom="10"/></VBox.margin>
    </Label>

    <VBox fx:id="accountsCard" styleClass="profile-card" spacing="0"/>

    <Label text="INSTRUCTIONS" styleClass="section-header">
        <VBox.margin><Insets top="24" bottom="10"/></VBox.margin>
    </Label>
    <VBox styleClass="profile-card" spacing="10">
        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
        <Label text="•  Tap any credential above to auto-login" styleClass="instruction"/>
        <Label text="•  Each user has different role permissions" styleClass="instruction"/>
        <Label text="•  Session persists until logout" styleClass="instruction"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>
</VBox>
