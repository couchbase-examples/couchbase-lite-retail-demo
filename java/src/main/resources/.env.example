# Couchbase App Services configuration — copy this file to .env and fill in.
# These mirror the values used by the iOS / Android / .NET versions.

# Public Connection URL from Capella App Services > Connect tab (without the
# trailing database name — that's appended at runtime based on the user's store).
CBL_BASE_URL=wss://your-endpoint.apps.cloud.couchbase.com:4984

# App Endpoint database names
CBL_AA_DB=supermarket-aa
CBL_NYC_DB=supermarket-nyc

# Demo App Users provisioned in your Capella App Endpoint
CBL_AA_USER=aa-store-01@supermarket.com
CBL_NYC_USER=nyc-store-01@supermarket.com
CBL_PASSWORD=P@ssword1
